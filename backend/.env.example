# Database
DATABASE_URL=mysql+aiomysql://root:root123@localhost:3306/english_coach?charset=utf8mb4

# AI Provider (claude | deepseek | glm)
# glm (智谱 GLM-4-Flash) 完全免费，推荐使用
# AI 配置统一在此处管理，前端不再提供覆盖入口；修改后需重启后端生效
AI_PROVIDER=glm
AI_API_KEY=your-zhipu-api-key-here
# 具体模型 ID，留空则按 provider 走默认（claude/deepseek/glm 默认值见 ai/factory.py）
AI_MODEL=glm-5.2

# ⚠️ 安全提示：生产环境部署时务必启用 HTTPS，否则 API Key 将以明文传输

# Redis (optional — cache auto-degrades when unavailable)
REDIS_URL=redis://localhost:6379/0

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── 部署环境 ─────────────────────────────────────────────
# dev（默认）：允许使用下方兜底弱配置并打印告警，仅限本地调试
# production：弱口令/占位 JWT 密钥将导致服务拒绝启动
APP_ENV=dev

# ── 登录凭证与 JWT ──────────────────────────────────────
# AUTH_PASSWORD 必须存 bcrypt 哈希（不要写明文密码）。
# 生成强口令哈希：
#   python -c "import bcrypt;print(bcrypt.hashpw(b'你的强密码',bcrypt.gensalt()).decode())"
# 下面这行是 "admin123" 的哈希，仅供本地开发快速登录，生产务必替换为你自己的强口令哈希。
AUTH_USERNAME=admin
AUTH_PASSWORD=$2b$12$3K/4jQMX94BkUoHgDM1ydevtqLdIY.jjngclPKniHi2C6aOMltWSy

# JWT 签名密钥，生产必须替换为强随机值：
#   openssl rand -base64 32
JWT_SECRET_KEY=PLEASE_RUN_OPENSSL_RAND_BASE64_32
JWT_EXPIRE_MINUTES=1440

# ── 现金激励（Cash Incentive）────────────────────────────
# 总开关：false（默认）= 完全不发钱；true = 启用周学习现金 + 里程碑奖金。
# 金额累计进 member.cash_balance 虚拟钱包，线下兑现（系统只记账，不建兑现流水）。
# 防通胀：周现金奖「每周质量」、里程碑奖「离散成就」，不重复支付；详见 docs/Settlement.md。
# 金额规则：周现金按 stars+plan_completion 分档；里程碑达标即发、每项终身一次。
# 翻开关只对未来周生效（历史已结算周不补发）；历史里程碑首次打开页面时一次性发放。
CASH_ENABLED=false
CASH_CURRENCY=CNY
CASH_WEEKLY_CAP=50.0
# 周现金分档（星数 + 计划完成度 → 元）
CASH_TIER_5_FULL=50.0
CASH_TIER_5=40.0
CASH_TIER_4_FULL=30.0
CASH_TIER_4=20.0
CASH_TIER_3=10.0
# 里程碑奖金
CASH_MS_UNIT_BIG=100.0
CASH_MS_UNIT_MID=50.0
CASH_MS_UNIT_SMALL=30.0
CASH_MS_WORDS_100=10.0
CASH_MS_WORDS_500=20.0
CASH_MS_WORDS_1000=50.0
CASH_MS_WORDS_2000=100.0
CASH_MS_STREAK_4=20.0
CASH_MS_STREAK_8=50.0
CASH_MS_STREAK_12=100.0
